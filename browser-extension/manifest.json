{
  "manifest_version": 3,
  "name": "Maher Download Manager - Browser Companion",
  "version": "2.0.0",
  "description": "Browser companion with opt-in automatic capture and authenticated local pairing",
  "permissions": [
    "activeTab",
    "contextMenus",
    "downloads",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:17691/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "ماهر دانلود منیجر",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}